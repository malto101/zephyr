config TEST_EXTRA_STACK_SIZE
	default 2048

config IDLE_STACK_SIZE
	default 1024

# Calls through printk() alone take over 1 KiB of stack, so the kernel
# default of 1024 overflows main() in tests that log from it.
config MAIN_STACK_SIZE
	default 4096 if COVERAGE_GCOV
	default 2048

config PRIVILEGED_STACK_SIZE
	# Sizes thread->arch.priv_stack, the kernel-side stack each K_USER
	# thread uses for event/syscall handling (see arch_user_mode_enter()).
	# 1024 was too small for some syscalls' C call depth; 2048 covers
	# everything hit so far but is an empirical, not proven, bound.
	# With HW_STACK_PROTECTION, 128 bytes at the bottom of this array
	# are reserved as FRAMELIMIT headroom for an event frame.
	default 2048

config CPU_HAS_HEXAGON_HVX
	bool
	help
	  Selected by SoCs whose CPU has Hexagon Vector eXtensions (HVX).

config HEXAGON_HVX
	bool "HVX coprocessor support"
	depends on CPU_HAS_HEXAGON_HVX
	depends on !SMP
	help
	  Use Hexagon Vector eXtensions (HVX) from your application, with
	  compiler intrinsics or assembly. Any thread can run HVX code without
	  any setup, and each thread keeps its own vector registers across
	  context switches. Threads that never use HVX don't pay for it.
	  A thread done with vector work can call hexagon_hvx_release() to
	  free its context for others. HVX can't be used from interrupt
	  handlers.

config HEXAGON_HVX_SAVE_AREAS
	int "HVX save areas"
	depends on HEXAGON_HVX
	default 2
	range 1 32
	help
	  How many threads can use HVX at the same time on top of the number
	  of hardware HVX contexts. Raise it if your application runs more
	  HVX threads than the hardware has contexts. Each one costs about
	  4 KB of RAM.

if CPU_HAS_MMU

config HEXAGON_MMU
	bool "Hexagon MMU Support"
	select MMU
	select KERNEL_DIRECT_MAP
	select SRAM_REGION_PERMISSIONS
	help
	  Enable memory management unit support for the Hexagon architecture.
	  The kernel and each memory domain get an HVM page table
	  (VM_TRANS_TYPE_TABLE) with 4KB pages over KERNEL_VM, which must hold
	  the kernel image.

config HEXAGON_MMU_L2_TABLES
	int "Second-level page tables for mappings outside KERNEL_VM"
	depends on HEXAGON_MMU
	default 16
	help
	  KERNEL_VM has its own second-level tables. Mappings elsewhere, such
	  as K_MEM_DIRECT_MAP device MMIO, take one table from this pool for
	  each 4MB region they touch. 4KB each.

config HEXAGON_H2_KERNEL_BASE
	hex "H2 hypervisor kernel image base address"
	depends on HEXAGON_MMU
	default 0x9b800000
	help
	  Guest-visible address of the H2 kernel image. The kernel's linear
	  map keeps it mapped RWX for guest mode only. Must be 4MB-aligned.

config HEXAGON_H2_KERNEL_SIZE
	hex "H2 hypervisor kernel image size"
	depends on HEXAGON_MMU
	default 0x800000
	help
	  Size of the H2 kernel image window at HEXAGON_H2_KERNEL_BASE. Must
	  be a non-zero multiple of 4MB, at most 16MB.

endif # CPU_HAS_MMU
