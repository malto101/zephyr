choice HEXAGON_EXECUTION_MODE
	prompt "Hexagon execution environment"
	default HEXAGON_NATIVE if SOC_LEMANS_CDSP0
	default HEXAGON_HVM_GUEST
	help
	  Select whether Hexagon runs as an H2 virtual-machine guest or directly
	  in native supervisor mode.

config HEXAGON_HVM_GUEST
	bool "H2 hypervisor guest"
	help
	  Run Zephyr as a guest under the H2 Hexagon virtual machine. This is the
	  execution mode used by the QEMU Hexagon board.

config HEXAGON_NATIVE
	bool "Native supervisor mode"
	select ARCH_HAS_SINGLE_THREAD_SUPPORT
	help
	  Run Zephyr directly on a Hexagon subsystem without the H2 hypervisor.
	  Native targets provide their own reset, interrupt, timer, and memory
	  management backends.

endchoice

config TEST_EXTRA_STACK_SIZE
	default 2048

config IDLE_STACK_SIZE
	default 1024

config PRIVILEGED_STACK_SIZE
	# Sizes thread->arch.priv_stack, the kernel-side stack each K_USER
	# thread uses for event/syscall handling (see arch_user_mode_enter()).
	# 1024 was too small for some syscalls' C call depth; 2048 covers
	# everything hit so far but is an empirical, not proven, bound.
	default 2048

config HEXAGON_MEM_DOMAIN_STACK_ENTRIES
	int "Linear-map entries per memory domain for member thread stacks"
	depends on USERSPACE
	default 16
	help
	  Each memory domain's linear list maps the stacks of all its user
	  mode threads. A page-aligned stack takes one entry, an unaligned
	  one up to a few. A user stack that does not fit faults on access.

if CPU_HAS_MMU

config HEXAGON_MMU
	bool "Hexagon MMU Support"
	select MMU
	select KERNEL_DIRECT_MAP
	select SRAM_REGION_PERMISSIONS
	help
	  Enable memory management unit support for the Hexagon architecture.
	  The HVM/H2 hypervisor maintains a single flat identity-mapped page
	  table, so mappings require virt == phys and KERNEL_DIRECT_MAP is
	  mandatory here.

endif # CPU_HAS_MMU
