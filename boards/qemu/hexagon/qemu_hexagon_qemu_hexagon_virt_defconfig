CONFIG_COMPILER_RT_RTLIB=y
CONFIG_BUILD_OUTPUT_BIN=y
CONFIG_PRINTK=y

# Serial console
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_CONSOLE=y
CONFIG_EARLY_CONSOLE=y

# Hexagon-specific features
CONFIG_HEXAGON_TIMER=y

# Debug and development options
CONFIG_EXCEPTION_DEBUG=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_STACK_SENTINEL=y
CONFIG_USERSPACE=y
CONFIG_THREAD_CUSTOM_DATA=y

# Hexagon's ABI is register-heavy (callee-saved r16-r27 are 48 bytes per
# frame), and CONFIG_USERSPACE adds a syscall trampoline frame on top of
# every privileged call chain; the defaults are too small.
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_ZTEST_STACK_SIZE=4096
CONFIG_PRIVILEGED_STACK_SIZE=4096
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_IDLE_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=4096
CONFIG_TEST_EXTRA_STACK_SIZE=4096

# QEMU emulation.
#
# icount sleep must be on. With sleep=off QEMU is supposed to warp the clock to
# the next deadline whenever the guest idles, but the guest idles inside an H2
# vmwait hypercall, which QEMU does not see as a halted CPU. It therefore
# advances virtual time by executing instructions, and a test that spends most
# of its time asleep costs real host time in proportion to the time it slept:
# tests/kernel/sleep (3.3 s of simulated time) does not finish in 240 s with
# sleep=off, and takes 20 s with it on.
CONFIG_QEMU_ICOUNT_SHIFT=3
CONFIG_QEMU_ICOUNT_SLEEP=y
